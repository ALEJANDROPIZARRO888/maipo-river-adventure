# Copia estos nombres en Vercel -> Settings -> Environment Variables.
# Nunca subas valores reales a este repositorio.

# Base de datos (la crea sola la integración Neon de Vercel)
DATABASE_URL=

# Clave para entrar a /admin y usar la API de administración
ADMIN_TOKEN=

# Correo (Gmail con "contraseña de aplicación")
GMAIL_USER=maiporiveradventure@gmail.com
GMAIL_APP_PASSWORD=

# Correo donde llegan los avisos de reservas (por defecto, el mismo Gmail)
ADMIN_EMAIL=maiporiveradventure@gmail.com

# Opcional: URL base para los links de ficha (por defecto usa el dominio actual)
PUBLIC_BASE_URL=

# Opcional: alternativa a Gmail
RESEND_API_KEY=
MAIL_FROM=
